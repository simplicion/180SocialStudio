# ==============================================================================
# 180 SOCIAL STUDIO DEDICATED BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================

# --- Server Configuration -----------------------------------------------------
NODE_ENV=production
RUN_MODE=api
PORT=4005
SOCIAL_STUDIO_PORT=4005
API_BASE_URL="http://18.207.84.197:4005"
CLIENT_URL="https://180workspace.com,https://api.180workspace.com,http://localhost:3000,http://localhost:3002,http://localhost:3007,http://18.207.84.197:4005"

# --- Security & JWT Secrets ---------------------------------------------------
JWT_SECRET=your_production_jwt_secret_here
JWT_ACCESS_SECRET=your_production_jwt_access_secret_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_here
SUPER_ADMIN_JWT_SECRET=your_super_admin_jwt_secret_here
DESKTOP_DEVICE_JWT_SECRET=your_desktop_device_jwt_secret_here
DESKTOP_DEVICE_ENFORCEMENT=off

# --- Dedicated Database (PostgreSQL on AWS RDS pitchin-db) ---------------------
DATABASE_URL="postgresql://pitchin_admin:PASSWORD@pitchin-db.csne8mek4dog.us-east-1.rds.amazonaws.com:5432/180workspace_db?schema=social_studio&sslmode=require&connection_limit=5&connect_timeout=60&pool_timeout=60"
DIRECT_URL="postgresql://pitchin_admin:PASSWORD@pitchin-db.csne8mek4dog.us-east-1.rds.amazonaws.com:5432/180workspace_db?schema=social_studio&sslmode=require&connection_limit=5&connect_timeout=60&pool_timeout=60"
CORE_DATABASE_URL="postgresql://pitchin_admin:PASSWORD@pitchin-db.csne8mek4dog.us-east-1.rds.amazonaws.com:5432/180core_db?sslmode=require&connection_limit=5&connect_timeout=60&pool_timeout=60"
DEVELOPERS_DATABASE_URL="postgresql://pitchin_admin:PASSWORD@pitchin-db.csne8mek4dog.us-east-1.rds.amazonaws.com:5432/180core_db?sslmode=require&connection_limit=5&connect_timeout=60&pool_timeout=60"

# --- Cache & Queues (Redis ElastiCache) ----------------------------------------
REDIS_URL="redis://pitchin-redis.epzdlc.0001.use1.cache.amazonaws.com:6379"
REDIS_INTERNAL_URL="redis://pitchin-redis.epzdlc.0001.use1.cache.amazonaws.com:6379"

# --- Cloudflare R2 Storage (Media Deliverables, Reels CDN) --------------------
STORAGE_PROVIDER=r2
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="180workspace"
CLOUDFLARE_R2_BUCKET_NAME="180workspace"
REELS_CDN_URL="https://pub-73622b8ffeaa436d83a676e27d5739a6.r2.dev"
R2_ACCESS_KEY="your_r2_access_key"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_KEY="your_r2_secret_key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_key"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_PUBLIC_DOMAIN="https://pub-73622b8ffeaa436d83a676e27d5739a6.r2.dev"
AWS_REGION="us-east-1"

# --- 180 Core Identity & Pay Integration ---------------------------------------
IDENTITY_SERVER_URL="https://api.180core.cloud"
IDENTITY_AUTH_URL="https://profile.180core.cloud"
ONE_EIGHTY_CLIENT_ID="180-social-studio-mobile"
NEXT_PUBLIC_180_CLIENT_ID="180-social-studio-mobile"
ONE_EIGHTY_CLIENT_SECRET="your_180_client_secret"
ONE_EIGHTY_WEBHOOK_SECRET="your_180_webhook_secret"
CORE_BACKEND_INTERNAL_URL="https://api.180core.cloud"
ONE_EIGHTY_PAY_CORE_URL="https://api.180core.cloud"

# --- Google OAuth & YouTube API -----------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
YOUTUBE_CLIENT_ID="your_youtube_client_id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret"

# --- Default Admin Credentials ------------------------------------------------
ADMIN_EMAIL="admin@180workspace.com"
ADMIN_PASSWORD="your_admin_password"

# --- Email Configuration (Nodemailer SMTP) ------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM="your_email@gmail.com"

# --- Payment Gateway (Razorpay) -----------------------------------------------
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# --- Social Media Publishing & Multi-Platform Hub -----------------------------
ALLOW_SIMULATED_PUBLISHING=false
SIMULATE_SOCIAL_PUBLISHING=false
SOCIAL_OAUTH_CALLBACK_BASE_URL="https://api.180workspace.com"
SOCIAL_MEDIA_PUBLIC_BASE_URL="https://api.180workspace.com"
SOCIAL_TOKEN_ENCRYPTION_KEY="your_32_byte_base64_encryption_key"
SOCIAL_SCHEDULER_ENABLED=true
SOCIAL_SCHEDULER_INTERVAL_MS=30000
SOCIAL_TOKEN_REFRESH_SKEW_SEC=300

# Meta Platform & Graph API (Facebook Pages & Webhooks)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_BUSINESS_ID="your_meta_business_id"
META_GRAPH_VERSION="v21.0"
META_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token"
FACEBOOK_PAGE_ID="your_facebook_page_id"

# Instagram Business Login
INSTAGRAM_APP_ID="your_instagram_app_id"
INSTAGRAM_APP_SECRET="your_instagram_app_secret"
INSTAGRAM_TEST_ACCOUNT_ID="your_instagram_account_id"
INSTAGRAM_TEST_USERNAME="your_instagram_username"

# Threads API
THREADS_APP_ID="your_threads_app_id"
THREADS_APP_SECRET="your_threads_app_secret"

# LinkedIn Marketing & Community Management API
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_PROVIDER_MODE="live"
LINKEDIN_API_VERSION="202507"

# --- Stock Media & B-Roll (Pexels & Pixabay) -----------------------------------
PEXELS_API_KEY="your_pexels_api_key"
PIXABAY_API_KEY="your_pixabay_api_key"

# --- AI Voice & Speech-to-Text Engine (Cartesia) ------------------------------
CARTESIA_API_KEY="your_cartesia_api_key"
CARTESIA_ADMIN_API_KEY="your_cartesia_admin_api_key"
VOICE_STT_PROVIDER="cartesia"

PRISMA_GENERATE_SKIP=true