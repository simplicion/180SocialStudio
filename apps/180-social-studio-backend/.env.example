# ==============================================================================
# 180 SOCIAL STUDIO DEDICATED BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Server Configuration -----------------------------------------------------
PORT=4005
SOCIAL_STUDIO_PORT=4005
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:3002,http://10.0.2.2:4005

# --- Dedicated Database (PostgreSQL) ------------------------------------------
# Replace with your dedicated PostgreSQL connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_studio_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/social_studio_db?schema=public"

# --- Redis Cache & Distributed Event Queue ------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# --- Authentication & Security ------------------------------------------------
JWT_SECRET="replace-with-a-secure-random-64-character-jwt-secret-key"
JWT_ACCESS_SECRET="replace-with-a-secure-random-64-character-jwt-access-secret"
JWT_REFRESH_SECRET="replace-with-a-secure-random-64-character-jwt-refresh-secret"
DESKTOP_DEVICE_JWT_SECRET="replace-with-a-secure-random-32-character-device-secret"
DESKTOP_DEVICE_ENFORCEMENT="off"

# --- Media Storage (AWS S3 or Cloudflare R2) ----------------------------------
# Leave blank to use local server storage in /uploads
STORAGE_PROVIDER="local"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-social-studio-bucket"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com" # For Cloudflare R2
# S3_PUBLIC_DOMAIN="https://cdn.yourdomain.com"

# --- AI Providers (Autonomous Video Director, Captions, Hook Scorer) ----------
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# --- Stock Media Providers (Pexels, Unsplash, Pixabay) ------------------------
PEXELS_API_KEY="your-pexels-api-key"
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
PIXABAY_API_KEY="your-pixabay-api-key"

# --- Social Media Platforms OAuth ---------------------------------------------
# Meta (Instagram & Facebook)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_WEBHOOK_VERIFY_TOKEN="your-meta-verify-token"

# LinkedIn
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:4005/api/v1/social-media/accounts/oauth/callback/linkedin"

# YouTube (Google Cloud OAuth)
YOUTUBE_CLIENT_ID="your-google-oauth-client-id"
YOUTUBE_CLIENT_SECRET="your-google-oauth-client-secret"
YOUTUBE_REDIRECT_URI="http://localhost:4005/api/v1/social-media/accounts/oauth/callback/youtube"

# TikTok
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="http://localhost:4005/api/v1/social-media/accounts/oauth/callback/tiktok"

# X (Twitter)
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"
TWITTER_REDIRECT_URI="http://localhost:4005/api/v1/social-media/accounts/oauth/callback/twitter"

# Pinterest
PINTEREST_APP_ID="your-pinterest-app-id"
PINTEREST_APP_SECRET="your-pinterest-app-secret"
PINTEREST_REDIRECT_URI="http://localhost:4005/api/v1/social-media/accounts/oauth/callback/pinterest"

# Threads
THREADS_APP_ID="your-threads-app-id"
THREADS_APP_SECRET="your-threads-app-secret"
THREADS_REDIRECT_URI="http://localhost:4005/api/v1/social-media/accounts/oauth/callback/threads"