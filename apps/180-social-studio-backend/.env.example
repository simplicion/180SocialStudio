# ==============================================================================
# 180 SOCIAL STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- Server & Network ---------------------------------------------------------
NODE_ENV=production
PORT=4005
SOCIAL_STUDIO_PORT=4005
API_BASE_URL="http://18.207.84.197:4005"
CLIENT_URL="https://180workspace.com,https://api.180workspace.com,http://localhost:3000,http://localhost:3002,http://localhost:3007,http://18.207.84.197:4005"

# --- Security & JWT Secrets ---------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
SUPERADMIN_JWT_SECRET=your_superadmin_jwt_secret_here
SUPER_ADMIN_JWT_SECRET=your_superadmin_jwt_secret_here
DESKTOP_DEVICE_JWT_SECRET=your_device_jwt_secret_here
DESKTOP_DEVICE_ENFORCEMENT=off

# --- Dedicated Database (PostgreSQL RDS pitchin-db) ---------------------------
DATABASE_URL="postgresql://user:password@host:5432/180workspace_db?schema=social_studio&sslmode=require&connection_limit=5&connect_timeout=60&pool_timeout=60"
DIRECT_URL="postgresql://user:password@host:5432/180workspace_db?schema=social_studio&sslmode=require&connection_limit=5&connect_timeout=60&pool_timeout=60"

# --- Distributed Cache & Queue (AWS ElastiCache Redis) ------------------------
REDIS_URL="redis://your-redis-host:6379"

# --- Cloudflare R2 Media Storage & CDN ----------------------------------------
STORAGE_PROVIDER=r2
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="180workspace"
R2_ACCESS_KEY="your_r2_access_key"
R2_SECRET_KEY="your_r2_secret_key"
REELS_CDN_URL="https://pub-<hash>.r2.dev"
AWS_REGION="us-east-1"

# --- 180 Identity Provider Integration (Universal SSO) -----------------------
IDENTITY_SERVER_URL="https://api.180core.cloud"
IDENTITY_AUTH_URL="https://profile.180core.cloud"

# --- Social Media Publishing Hub ---------------------------------------------
ALLOW_SIMULATED_PUBLISHING=false
SIMULATE_SOCIAL_PUBLISHING=false

# Public API & Media CDN URLs
SOCIAL_OAUTH_CALLBACK_BASE_URL="http://localhost:4002"
SOCIAL_MEDIA_PUBLIC_BASE_URL="http://localhost:4002"

# Token Vault AES-256-GCM Encryption Key (Never share or commit publicly)
SOCIAL_TOKEN_ENCRYPTION_KEY="your_32_byte_base64_encryption_key"

# Token Refresh & Publishing Scheduler Controls
SOCIAL_SCHEDULER_ENABLED=true
SOCIAL_SCHEDULER_INTERVAL_MS=30000
SOCIAL_TOKEN_REFRESH_SKEW_SEC=300

# Meta Platform & Graph API (Facebook Pages & Webhooks)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_BUSINESS_ID="your_meta_business_id"
META_GRAPH_VERSION="v21.0"
META_WEBHOOK_VERIFY_TOKEN="your_verify_token"

# Instagram Business Login
INSTAGRAM_APP_ID="your_instagram_app_id"
INSTAGRAM_APP_SECRET="your_instagram_app_secret"
INSTAGRAM_TEST_ACCOUNT_ID="your_instagram_test_account_id"
INSTAGRAM_TEST_USERNAME="your_instagram_test_username"

# Threads API
THREADS_APP_ID="your_threads_app_id"
THREADS_APP_SECRET="your_threads_app_secret"

# LinkedIn Marketing & Community Management API
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# Google & YouTube Data API
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# --- Stock Media & B-Roll (Pexels & Pixabay) -----------------------------------
PEXELS_API_KEY="your_pexels_api_key"
PIXABAY_API_KEY="your_pixabay_api_key"
NEXT_PUBLIC_PIXABAY_API_KEY="your_pixabay_api_key"

# --- AI Voice & Speech-to-Text Engine (Cartesia) ------------------------------
CARTESIA_API_KEY="your_cartesia_api_key"
VOICE_STT_PROVIDER="cartesia"

# --- Email Notifications (Nodemailer SMTP) ------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM="your_email@gmail.com"